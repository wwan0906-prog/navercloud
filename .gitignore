# 가상환경
venv/
.venv/
env/

# API 키·인증 (절대 커밋 금지)
.env
*.pem
*.key

# 데이터 (AI허브 데이터는 재배포 금지 — 스크립트만 공유)
data/*
!data/.gitkeep
ml/dataset/
*.csv
*.jsonl
*.zip
*.tar
*.part*

# 실행 결과 원본 (md 요약만 커밋)
**/results/*.jsonl
*.mp3

# 파이썬
__pycache__/
*.py[cod]
*$py.class

# Node / Expo
node_modules/
.expo/
dist/
*.apk
*.ipa

# 에디터 및 OS
.vscode/
.idea/
.DS_Store
Thumbs.db
