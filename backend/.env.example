# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env

# CLOVA OCR > Domain > (General 도메인) > API Gateway 연동
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=

# AI·NAVER API > Application > AITEST > 인증 정보
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=

# AI 호출 모드: mock = 가짜 응답 (2번 팀원 HCX 연결 전), real = 실제 호출
AI_MODE=mock
