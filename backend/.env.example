# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env

# CLOVA OCR > Domain > (General 도메인) > API Gateway 연동
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=

# AI·NAVER API > Application > AITEST > 인증 정보
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=

# CLOVA Studio (HCX 분류·추출, app/hcx.py)
#   튜닝 모델 URL: https://clovastudio.stream.ntruss.com/v2/tasks/{HCX_TUNING_TASK_ID}/chat-completions
CLOVASTUDIO_API_KEY=
HCX_TUNING_TASK_ID=

# Papago 번역 (선택). 비워두면 외국어 번역을 HCX 로 합니다 (AI_MODE=real 일 때)
#   AI·NAVER API > Application > (Papago Translation 선택) > 인증 정보
PAPAGO_CLIENT_ID=
PAPAGO_CLIENT_SECRET=

# AI 호출 모드: real = 실제 HCX 호출 (배포 서버), mock = 키워드 기반 가짜 응답 (HCX 사용량 없이 개발할 때)
AI_MODE=mock
